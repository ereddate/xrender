{
  "name": "xr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "IE 11"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ssg": "vite build --config vite.config.ssg.js",
    "build:libs": "vite build --config vite.config.libs.js",
    "build:fetch": "vite build --config vite.config.fetch.js",
    "build:router": "vite build --config vite.config.router.js",
    "build:store": "vite build --config vite.config.store.js",
    "build:i18n": "vite build --config vite.config.i18n.js",
    "build:touchs": "vite build --config vite.config.touchs.js",
    "build:sfc": "vite build --config vite.config.sfc.js",
    "build:xprogress": "vite build --config vite.config.xprogress.js",
    "build:ssg:module": "vite build --config vite.config.ssg.module.js",
    "build:keep-alive": "vite build --config vite.config.keep-alive.js",
    "build:all": "npm run build:libs && npm run build:fetch && npm run build:router && npm run build:store && npm run build:i18n && npm run build:touchs && npm run build:sfc && npm run build:xprogress && npm run build:ssg:module && npm run build:keep-alive && node scripts/post-build.js latest",
    "post-build:latest": "node scripts/post-build.js latest",
    "post-build:clean": "node scripts/post-build.js clean",
    "post-build:list": "node scripts/post-build.js list",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "version:get": "node scripts/version.js get",
    "version:set": "node scripts/version.js set",
    "version:bump": "node scripts/version.js bump",
    "version:bump-all": "node scripts/version.js bump-all"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/runtime-corejs3": "^7.28.4",
    "@rollup/plugin-babel": "^6.1.0",
    "@vitest/ui": "^4.0.16",
    "intl-messageformat": "^10.3.5",
    "jsdom": "^27.4.0",
    "less": "^4.5.1",
    "markdown-it-container": "^4.0.0",
    "sass": "^1.87.0",
    "terser": "^5.39.0",
    "vite": "^6.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "core-js": "^3.47.0",
    "fuse.js": "^7.1.0",
    "glob": "^13.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^4.3.0"
  }
}
